# Use a database name that's DIFFERENT from your bakery app's database
# (e.g. "devis_kitchen"), even if it's the same Neon project/host — this keeps
# the two apps' tables (orders, menu_items, staff, etc.) completely separate.
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/devis_kitchen?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# Push notifications (order status updates) — the ENTIRE contents of the
# service-account JSON downloaded from Firebase Console → devis-kitchen-orders
# project → Project Settings → Service Accounts → Generate new private key,
# pasted in as one line. A dedicated Firebase project for this app, separate
# from the cricket-nets-app (Pavilion) project. Leave unset and push just
# quietly no-ops — nothing else in the app depends on it.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"devis-kitchen-orders",...}
